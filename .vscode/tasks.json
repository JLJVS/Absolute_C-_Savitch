{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "build (debug)",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-g",
        "-D_GLIBCXX_ASSERTIONS",
        "-fsanitize=undefined",
        "-fsanitize-undefined-trap-on-error",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "detail": "Warnings on, debug info, UB traps. Use for everyday work."
    },
    {
      "type": "cppbuild",
      "label": "build (release)",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-O2",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "detail": "Optimised. Use this for any timing measurement."
    }
  ]
}
